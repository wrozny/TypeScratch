sprite Duck {
    @start {
        let counter = 0

        repeat 2 + 3 {
            counter += 1
        }

        while counter < 10 and check_some(counter) {
            counter += 1
        }

        if counter == 10 {
            say("Ten")
        } else if counter > 10 {
            say("More than ten")
        } else {
            say("Less than ten")
        }

        forever {
            say(counter)
        }
    }
}
